{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/d1ys3nk0/vcm/blob/main/schema/workspace.schema.json",
  "title": "VCM workspace configuration",
  "description": "Structural validation; vcm validate additionally checks Git branch syntax, path safety, identities, and dependency graph.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "trunk",
    "repositories"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "trunk": {
      "type": "string",
      "minLength": 1
    },
    "hooks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "command"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
              },
              "command": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "pre-merge": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "command"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
              },
              "command": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "post-merge": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "command"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
              },
              "command": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "drop": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "command"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
              },
              "command": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "repositories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "path",
          "url",
          "trunk"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
            "not": {
              "const": "workspace"
            }
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "trunk": {
            "type": "string",
            "minLength": 1
          },
          "depends_on": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "hooks": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "create": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "command"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
                    },
                    "command": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              "merge": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "command"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
                    },
                    "command": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              "drop": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "command"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
                    },
                    "command": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
